# ==============================================================================
# Backend Environment Configuration - Invexom Contact Manager
# ==============================================================================

# Server port (Defaults to 5000 locally; Render automatically injects PORT in production)
PORT=5000

# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# MongoDB Connection String:
# - For local development with MongoDB installed locally:
#   MONGODB_URI=mongodb://127.0.0.1:27017/contact_manager
# - For cloud deployment using MongoDB Atlas:
#   MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-subdomain>.mongodb.net/contact_manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/contact_manager

# Allowed Frontend Origins (CORS whitelist):
# Comma-separated list of allowed origins without trailing slashes. Wildcard (*) is supported for testing.
# - Local: http://localhost:5173
# - Production: https://<your-app>.vercel.app
CLIENT_URL=http://localhost:5173
